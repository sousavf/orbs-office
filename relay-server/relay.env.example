# Copy to relay.env (gitignored), chmod 600, and fill in. Never commit the real file.
# Publish token the bridge presents; at least 32 characters: openssl rand -hex 32
PUBLISH_TOKEN=replace-with-the-output-of-openssl-rand-hex-32
# Origin(s) of the public page (comma-separated). Needed for /live and the CORS-readable JSON endpoints.
ALLOWED_ORIGINS=https://office.example.com
# Optional: GET /metrics in Prometheus format. Off unless one of these is set; never route /metrics through the tunnel.
# METRICS_TOKEN=replace-with-another-openssl-rand-hex-32
# METRICS_ALLOW_LOOPBACK=1
